; ClearSpeak.inf - SKELETON. Replace with a copy of SYSVAD's ComponentizedAudioSample.inf,
; changing only names/GUIDs (see driver/ClearSpeak/README.md).
[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = ClearSpeak.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = ClearSpeak, NT$ARCH$.10.0...16299

[ClearSpeak.NT$ARCH$.10.0...16299]
%ClearSpeak.DeviceDesc% = ClearSpeak_Install, ROOT\ClearSpeak

; Service, wave/topology and endpoint sections: copy from the SYSVAD reference INF.

[Strings]
ProviderName        = "ClearSpeak"
ManufacturerName    = "ClearSpeak"
ClearSpeak.DeviceDesc = "ClearSpeak Virtual Audio Device"
